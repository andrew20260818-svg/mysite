---
import Layout from '../layouts/Layout.astro';
import LeadForm from '../components/LeadForm.astro';
import Faq from '../components/Faq.astro';
import {
  team, hero, whyUs, steps, schedule, rinks, levels, prices, priceBonus, players, coaches,
} from '../data/site';

const paths = [
  { title: 'Я новичок', text: 'Научим кататься и играть с нуля', href: '/nachat-igrat/', cta: 'Начать играть' },
  { title: 'Я играю, ищу команду', text: 'Матчи лиги по выходным', href: '/igry/', cta: 'Игры и команда' },
  { title: 'Хочу подтянуть технику', text: 'Занятия с тренером 1 на 1', href: '/trenirovki/', cta: 'Индивидуальные' },
];
const shortPrices = prices.slice(0, 4);
---

<Layout title={team.name}>
  <section class="hero">
    {hero.video ? (
      <video class="hero__media" autoplay muted loop playsinline poster={hero.poster || undefined}>
        <source src={hero.video} type="video/mp4" />
      </video>
    ) : hero.poster ? (
      <img class="hero__media" src={hero.poster} alt="" />
    ) : (
      <div class="hero__media hero__media--placeholder" aria-hidden="true"></div>
    )}
    <div class="hero__overlay"></div>
    <div class="container hero__content">
      <div class="eyebrow">{team.tagline}</div>
      <h1>{hero.title}</h1>
      <p class="hero__sub">{hero.subtitle}</p>
      <p class="hero__price">{hero.trialPrice}</p>
      <div class="btn-row">
        <a class="btn btn--primary" href="/zayavka/">Записаться на пробную</a>
        <a class="btn btn--ghost" href="/raspisanie/">Расписание</a>
      </div>
      <p class="hero__note">Ответим в течение дня · подскажем с экипировкой</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>С чего начнёте?</h2>
      <div class="grid grid--3">
        {paths.map((p) => (
          <a class="card" href={p.href}>
            <h3>{p.title}</h3>
            <p class="muted">{p.text}</p>
            <span class="link-arrow">{p.cta} →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="container">
      <h2>В команду за 3 шага</h2>
      <p class="lead">Уровень не важен, подберём группу.</p>
      <ol class="steps">
        {steps.map((s, i) => (
          <li class="card">
            <span class="big-number">{i + 1}</span>
            <h3>{s.title}</h3>
            <p class="muted">{s.text}</p>
          </li>
        ))}
      </ol>
      <a class="btn btn--primary" href="/zayavka/">Оставить заявку</a>
    </div>
  </section>

  <section class="section section--dark">
    <div class="container">
      <h2>Почему к нам приходят</h2>
      <div class="grid grid--4 why">
        {whyUs.map((w) => (
          <div>
            <div class="big-number">{w.value}</div>
            <p class="muted">{w.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Тренировки и игры</h2>
      <div class="grid grid--2">
        <div class="card">
          <span class="badge">Тренировки</span>
          <h3>{schedule.training.map((t, i) => (i ? t.day.toLowerCase() : t.day)).join(' и ')}, {schedule.training[0].time}</h3>
          <p class="muted">{rinks.training.title}, {rinks.training.address}, {rinks.training.metro}</p>
          <a class="btn btn--primary" href="/raspisanie/">Выбрать день</a>
        </div>
        <div class="card">
          <span class="badge">Игры</span>
          <h3>Суббота и воскресенье</h3>
          <p class="muted">{rinks.games.title}, {rinks.games.address}</p>
          <a class="btn btn--primary" href="/igry/">Как попасть в игру</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="container">
      <h2>Уровни</h2>
      <p class="lead">Найдите себя на шкале. Если сомневаетесь, тренер подскажет на пробной.</p>
      <ol class="levels">
        {levels.map((l, i) => (
          <li>
            <span class="levels__step">{i + 1}</span>
            <strong>{l.name}</strong>
            <span class="muted">{l.signs}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Цены коротко</h2>
      <div class="grid grid--4">
        {shortPrices.map((p) => (
          <div class={`card ${p.highlight ? 'card--hl' : ''}`}>
            <h3>{p.title}</h3>
            <div class="big-number">{p.price}</div>
            <p class="muted">{p.note}</p>
          </div>
        ))}
      </div>
      <p class="bonus">{priceBonus}</p>
      <div class="btn-row">
        <a class="btn btn--primary" href="/zayavka/">Записаться на пробную</a>
        <a class="btn btn--ghost" href="/ceny/">Все цены</a>
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="container">
      <h2>Команда</h2>
      <div class="roster">
        {players.slice(0, 6).map((p) => (
          <div class="roster__item">
            {p.photo ? <img src={p.photo} alt={p.name} class="placeholder-photo" /> : <div class="placeholder-photo">{p.number}</div>}
            <strong>{p.name}</strong>
            <span class="muted">{p.position}{p.cameAsBeginner ? `, пришёл новичком в ${p.since}` : ''}</span>
          </div>
        ))}
      </div>
      <a href="/sostav/">Весь состав →</a>

      <h2 class="mt">Тренеры</h2>
      <div class="grid grid--2">
        {coaches.map((c) => (
          <div class="card coach">
            {c.photo ? <img src={c.photo} alt={c.name} class="coach__photo" /> : <div class="placeholder-photo coach__photo">🏒</div>}
            <div>
              <h3>{c.name}</h3>
              <p class="muted">{c.role}. {c.experience}</p>
              <a href="/trenirovki/">Индивидуальные тренировки →</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Частые вопросы</h2>
      <Faq />
    </div>
  </section>

  <section class="section section--dark" id="zayavka">
    <div class="container final">
      <div>
        <h2>Запишитесь на пробную тренировку</h2>
        <p class="muted">Три минуты на заявку, и в понедельник или среду вы уже на льду. Если группа набрана, добавим в лист ожидания и напишем, когда появится место.</p>
      </div>
      <LeadForm id="form-home" />
    </div>
  </section>
</Layout>

<style>
  .hero { position: relative; min-height: min(88vh, 760px); display: flex; align-items: flex-end; color: #fff; overflow: hidden; }
  .hero__media { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero__media--placeholder { background: radial-gradient(circle at 70% 30%, #2f5f8f 0%, var(--navy-2) 40%, var(--navy) 100%); }
  .hero__overlay { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(11,29,51,.25) 0%, rgba(11,29,51,.85) 100%); }
  .hero__content { position: relative; padding-top: 80px; padding-bottom: 64px; }
  .hero h1 { max-width: 820px; }
  .hero__sub { font-size: 1.2rem; max-width: 680px; color: #e1eaf3; }
  .hero__price { font-weight: 800; font-size: 1.15rem; }
  .hero__note { margin-top: 14px; color: #c9d6e3; font-size: .95rem; }
  .link-arrow { color: var(--accent); font-weight: 700; margin-top: auto; }
  .steps { list-style: none; padding: 0; margin: 0 0 28px; display: grid; gap: 20px; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
  .why .muted { margin-top: 6px; }
  .levels { list-style: none; padding: 0; margin: 0; display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
  .levels li { display: grid; gap: 4px; padding: 18px; border-radius: var(--radius); background: var(--ice); border-left: 4px solid var(--blue); }
  .levels__step { font-weight: 800; color: var(--blue); }
  .card--hl { border: 2px solid var(--accent); }
  .bonus { margin: 20px 0; font-weight: 700; }
  .roster { display: grid; gap: 16px; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); margin-bottom: 16px; }
  .roster__item { display: grid; gap: 4px; font-size: .95rem; }
  .mt { margin-top: 48px; }
  .coach { flex-direction: row; align-items: flex-start; gap: 18px; }
  .coach__photo { width: 110px; flex-shrink: 0; object-fit: cover; aspect-ratio: 4/5; border-radius: 10px; font-size: 2rem; }
  .final { display: grid; gap: 32px; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); align-items: start; }
</style>
