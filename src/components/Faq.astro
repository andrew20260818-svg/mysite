---
import { faq } from '../data/site';

interface Props {
  limit?: number;
}

const { limit } = Astro.props;
const items = limit ? faq.slice(0, limit) : faq;
---

<div class="faq">
  {items.map((item) => (
    <details>
      <summary>{item.q}</summary>
      <p>{item.a}</p>
    </details>
  ))}
</div>
